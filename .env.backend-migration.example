# Appwrite -> Supabase file-copy settings.
# Copy to .env.backend-migration.local and enter real values ONLY in that local file.
# This example contains no credentials. Filling it does not run the migration.
# Where to find each value: docs/CREDENTIALS.md

# Appwrite project console: API endpoint for the project containing the old files.
# Example format: https://fra.cloud.appwrite.io/v1 (use your project's region).
APPWRITE_ENDPOINT=

# Appwrite project settings: Project ID, not the project name.
APPWRITE_PROJECT_ID=

# Appwrite Storage: open the old research/document bucket and copy its Bucket ID.
APPWRITE_BUCKET_ID=

# Appwrite project sidebar -> API Keys -> Create API key.
# Temporary migration key with files.read and buckets.read scopes only.
APPWRITE_API_KEY=

# Supabase: open the separate CREST project -> Connect -> Project URL.
# Example format: https://your-project-ref.supabase.co
SUPABASE_URL=

# Destination bucket name used by the prepared SQL migration. Keep this value.
SUPABASE_STORAGE_BUCKET=crest-files

# Supabase project settings -> API Keys: a server secret key (sb_secret_...).
# A legacy service_role key also works. Required for --copy, not --plan.
# Do not use the publishable/anon key or your Supabase CLI login token here.
SUPABASE_SECRET_KEY=

# Firebase settings are not needed for this file-copy script.
# The Supabase Edge Functions use separate server settings:
# supabase/functions/.env.example
