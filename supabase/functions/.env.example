# Settings for functions HOSTED IN SUPABASE. Firebase supplies Auth/Firestore/FCM.
# Enter real server values in Supabase Dashboard -> Edge Functions -> Secrets,
# or later in an ignored supabase/functions/.env file for CLI secret upload.
# Never place server secrets in VITE_* or Android BuildConfig.
# Detailed input guide: docs/CREDENTIALS.md

# Supabase supplies SUPABASE_URL and SUPABASE_SECRET_KEYS (or legacy service_role).
# Keep default unless the intended hosted secret key has a different name.
CREST_SUPABASE_KEY_NAME=default

# Keep both false until credentials and setup have been validated.
CREST_STORAGE_ENABLED=false
CREST_NOTIFICATIONS_ENABLED=false

# Final teacher website origin, e.g. https://crest-school.netlify.app.
# Leave the placeholder until Netlify is linked; this is not a password/key.
CREST_ALLOWED_ORIGINS=https://your-school-site.netlify.app

# Keep this bucket name to match the prepared SQL migration.
CREST_STORAGE_BUCKET=crest-files

# Firebase Console -> Project settings -> General -> Project ID.
CREST_FIREBASE_PROJECT_ID=

# Firebase Console -> Project settings -> Service accounts -> Generate new private key.
# Value: the COMPLETE downloaded service-account JSON, not its file path,
# google-services.json, the web API key, or the CLI login token.
# In the Supabase secret editor, paste the full JSON as its value.
# In a .env file, use single-quoted JSON on one line, preserving its \n escapes.
# Current gateway account has only Firestore read and Auth read permissions.
# FCM sending needs separate permission before notifications can be enabled.
CREST_FIREBASE_SERVICE_ACCOUNT_JSON=
