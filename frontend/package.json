    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "logo:sync": "node scripts/sync-logo.mjs",
    "logo:check": "node scripts/sync-logo.mjs --check",
    "licenses:sync": "node --experimental-strip-types scripts/sync-licenses.mjs",
    "licenses:check": "node --experimental-strip-types scripts/sync-licenses.mjs --check",
    "preview": "vite preview"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
