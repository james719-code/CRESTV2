# Register a web app in the SAME Firebase project as Android.
# These are public client settings. Never put service account keys here.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Match Android's Appwrite configuration; register your website hostname.
# Existing bucket permissions must authorize the web client.
VITE_APPWRITE_ENDPOINT=
VITE_APPWRITE_PROJECT_ID=
VITE_APPWRITE_BUCKET_ID=
