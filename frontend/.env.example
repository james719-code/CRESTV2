# Register a web app in the SAME Firebase project as Android.
# These are public client settings. Never put service account keys here.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=

# Leave disabled until setup and credential checks are done.
# disabled | appwrite | supabase. Edge Functions verify Firebase identity.
VITE_STORAGE_PROVIDER=disabled
VITE_SUPABASE_URL=
VITE_FCM_ENABLED=false
VITE_FIREBASE_VAPID_KEY=

# Match Android's Appwrite configuration; register your website hostname.
# Existing bucket permissions must authorize the web client.
VITE_APPWRITE_ENDPOINT=
VITE_APPWRITE_PROJECT_ID=
VITE_APPWRITE_BUCKET_ID=
