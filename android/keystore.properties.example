# Copy to keystore.properties and fill in your original release-key passwords.
# keystore.properties is ignored by Git. Do not commit your passwords or key.
# Relative storeFile paths start from android/. Use / for Windows path separators.
# Enter values without surrounding quotes; escape literal backslashes as \\.
storeFile=crest_jks
storePassword=
keyAlias=crest_jks
keyPassword=
